  "title": { "text": "How to work your hive" },
  "cards": [
    { "text": "Pick a warm, sunny day. Mid-morning is ideal, when most foragers are out working" },
    { "text": "Light your smoker FIRST. A few gentle puffs of cool white smoke at the entrance, then wait a minute before opening up" },
    { "text": "Move slowly and deliberately. No sudden movements, no bumping the boxes" },
    { "text": "Work from the side or back of the hive. Never block their flight path" },
    { "text": "Keep it short and purposeful. Know what you're checking before you lift the lid" },
    { "text": "Stay relaxed. Steady hands make for a settled colony" }
  ],
